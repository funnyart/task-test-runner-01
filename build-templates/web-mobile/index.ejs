<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <title>Play game</title>

  <!--http://www.html5rocks.com/en/mobile/mobifying/-->
  <meta name="viewport"
        content="width=device-width,initial-scale=1.0,maximum-scale=1.0,minimum-scale=1.0,user-scalable=no,viewport-fit=cover"/>

  <!--https://developer.apple.com/library/safari/documentation/AppleApplications/Reference/SafariHTMLRef/Articles/MetaTags.html-->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">

  <!-- force webkit on 360 -->
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <!-- force edge on IE -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="msapplication-tap-highlight" content="no">

  <!-- force full screen on some browser -->
  <meta name="full-screen" content="yes"/>
  <meta name="x5-fullscreen" content="true"/>
  <meta name="360-fullscreen" content="true"/>

  <!--fix fireball/issues/3568 -->
  <!--<meta name="browsermode" content="application">-->
  <meta name="x5-page-mode" content="app">

  <!--<link rel="apple-touch-icon" href=".png" />-->
  <!--<link rel="apple-touch-icon-precomposed" href=".png" />-->

  <link rel="stylesheet" type="text/css" href="style.css"/>

  <!-- AppLovin HTML analytics (LOADING / LOADED) -->
  <script>
    (function () {
      try {
        if (typeof window.ALPlayableAnalytics !== 'undefined' &&
            typeof window.ALPlayableAnalytics.trackEvent === 'function') {
          console.log('[ALPlayableAnalytics] LOADING (index.ejs)');
          window.ALPlayableAnalytics.trackEvent('LOADING');
        } else {
          console.log('[ALPlayableAnalytics] LOADING: SDK ещё недоступен (index.ejs)');
        }

        window.addEventListener('load', function () {
          if (typeof window.ALPlayableAnalytics !== 'undefined' &&
              typeof window.ALPlayableAnalytics.trackEvent === 'function') {
            console.log('[ALPlayableAnalytics] LOADED (window.load, index.ejs)');
            window.ALPlayableAnalytics.trackEvent('LOADED');
          } else {
            console.log('[ALPlayableAnalytics] LOADED: SDK недоступен при window.load (index.ejs)');
          }
        });
      } catch (e) {
        console.error('[ALPlayableAnalytics] Ошибка инициализации в index.ejs:', e);
      }
    })();
  </script>

</head>
<body>
<script>
(function(){'use strict';function lock(){try{window.scrollTo(0,0);document.documentElement.scrollTop=0;document.body.scrollTop=0;document.documentElement.scrollLeft=0;document.body.scrollLeft=0;}catch(e){}const de=document.documentElement;const b=document.body;if(!de||!b)return;de.style.overflow='hidden !important';de.style.overflowX='hidden !important';de.style.overflowY='hidden !important';de.style.overscrollBehavior='none !important';de.style.maxWidth='100vw !important';de.style.maxHeight='100vh !important';b.style.overflow='hidden !important';b.style.overflowX='hidden !important';b.style.overflowY='hidden !important';b.style.overscrollBehavior='none !important';b.style.position='fixed !important';b.style.inset='0 !important';b.style.width='100vw !important';b.style.height='100vh !important';b.style.maxWidth='100vw !important';b.style.maxHeight='100vh !important';b.style.margin='0 !important';b.style.padding='0 !important';b.style.border='0 !important';const gameDiv=document.getElementById('GameDiv');const gameContainer=document.getElementById('Cocos3dGameContainer');const canvas=document.getElementById('GameCanvas');if(gameDiv){gameDiv.style.maxWidth='100vw !important';gameDiv.style.maxHeight='100vh !important';gameDiv.style.overflow='hidden !important';}if(gameContainer){gameContainer.style.maxWidth='100vw !important';gameContainer.style.maxHeight='100vh !important';gameContainer.style.overflow='hidden !important';}if(canvas){canvas.style.maxWidth='100vw !important';canvas.style.maxHeight='100vh !important';canvas.style.overflow='hidden !important';}}function prevent(e){e.preventDefault();e.stopPropagation();return false;}document.addEventListener('touchmove',prevent,{passive:false,capture:true});document.addEventListener('wheel',prevent,{passive:false,capture:true});document.addEventListener('mousewheel',prevent,{passive:false,capture:true});document.addEventListener('DOMMouseScroll',prevent,{passive:false,capture:true});document.addEventListener('scroll',prevent,{passive:false,capture:true});window.addEventListener('scroll',lock,{passive:false});window.addEventListener('resize',lock,{passive:false});if(window.visualViewport){window.visualViewport.addEventListener('scroll',lock,{passive:false});window.visualViewport.addEventListener('resize',lock,{passive:false});}document.addEventListener('gesturestart',prevent,{passive:false});document.addEventListener('gesturechange',prevent,{passive:false});document.addEventListener('gestureend',prevent,{passive:false});lock();setInterval(lock,50);})();
</script>

  <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
      </div>
    </div>
  

<!-- Polyfills bundle. -->
<script src="src/polyfills.bundle.js" charset="utf-8"> </script>

<!-- SystemJS bundle. -->
<script src="src/system.bundle.js" charset="utf-8"> </script>

<!-- Import map for SystemJS. -->
<script src="src/import-map.json" type="systemjs-importmap" charset="utf-8"> </script>

<!-- Game entry point. -->
<script>
    System.import('./index.js').catch(function(err) { console.error(err); })
</script>

</body>
</html>

